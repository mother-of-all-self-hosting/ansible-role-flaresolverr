{% if flaresolverr_container_labels_traefik_enabled or flaresolverr_container_labels_traefik_metrics_enabled %}
traefik.enable=true

{% if flaresolverr_container_labels_traefik_enabled %}

{% if flaresolverr_container_labels_traefik_docker_network %}
traefik.docker.network={{ flaresolverr_container_labels_traefik_docker_network }}
{% endif %}

{% set middlewares = [] %}

{% if flaresolverr_container_labels_traefik_middleware_basic_auth_enabled %}
{% set middlewares = middlewares + [flaresolverr_identifier + '-basic-auth'] %}
traefik.http.middlewares.{{ flaresolverr_identifier }}-basic-auth.basicauth.users={{ flaresolverr_container_labels_traefik_middleware_basic_auth_users }}
{% endif %}

{% if flaresolverr_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ flaresolverr_identifier }}-slashless-redirect.redirectregex.regex=^({{ flaresolverr_container_labels_traefik_path_prefix | quote }})$
traefik.http.middlewares.{{ flaresolverr_identifier }}-slashless-redirect.redirectregex.replacement=${1}/
{% set middlewares = middlewares + [flaresolverr_identifier + '-slashless-redirect'] %}
{% endif %}

{% if flaresolverr_container_labels_traefik_path_prefix != '/' %}
traefik.http.middlewares.{{ flaresolverr_identifier }}-strip-prefix.stripprefix.prefixes={{ flaresolverr_container_labels_traefik_path_prefix }}
{% set middlewares = middlewares + [flaresolverr_identifier + '-strip-prefix'] %}
{% endif %}

traefik.http.routers.{{ flaresolverr_identifier }}.rule={{ flaresolverr_container_labels_traefik_rule }}
{% if flaresolverr_container_labels_traefik_priority | int > 0 %}
traefik.http.routers.{{ flaresolverr_identifier }}.priority={{ flaresolverr_container_labels_traefik_priority }}
{% endif %}
traefik.http.routers.{{ flaresolverr_identifier }}.service={{ flaresolverr_identifier }}
{% if middlewares | length > 0 %}
traefik.http.routers.{{ flaresolverr_identifier }}.middlewares={{ middlewares | join(',') }}
{% endif %}
traefik.http.routers.{{ flaresolverr_identifier }}.entrypoints={{ flaresolverr_container_labels_traefik_entrypoints }}
traefik.http.routers.{{ flaresolverr_identifier }}.tls={{ flaresolverr_container_labels_traefik_tls | to_json }}
{% if flaresolverr_container_labels_traefik_tls %}
traefik.http.routers.{{ flaresolverr_identifier }}.tls.certResolver={{ flaresolverr_container_labels_traefik_tls_certResolver }}
{% endif %}

traefik.http.services.{{ flaresolverr_identifier }}.loadbalancer.server.port={{ flaresolverr_container_http_port }}

{% endif %}

{% if flaresolverr_container_labels_traefik_metrics_enabled %}
########################################################################
#                                                                      #
# Metrics                                                              #
#                                                                      #
########################################################################

{% set middlewares = flaresolverr_container_labels_traefik_metrics_middlewares %}

{% if flaresolverr_container_labels_traefik_metrics_middleware_basic_auth_enabled %}
traefik.http.middlewares.{{ flaresolverr_identifier }}-metrics-basic-auth.basicauth.users={{ flaresolverr_container_labels_traefik_metrics_middleware_basic_auth_users }}
{% set middlewares = middlewares + [flaresolverr_identifier + '-metrics-basic-auth'] %}
{% endif %}

traefik.http.middlewares.{{ flaresolverr_identifier }}-metrics-replace-path.replacepath.path=/metrics
{% set middlewares = middlewares + [flaresolverr_identifier + '-metrics-replace-path'] %}

traefik.http.routers.{{ flaresolverr_identifier }}-metrics.rule={{ flaresolverr_container_labels_traefik_metrics_rule }}

{% if flaresolverr_container_labels_traefik_metrics_priority | int > 0 %}
traefik.http.routers.{{ flaresolverr_identifier }}-metrics.priority={{ flaresolverr_container_labels_traefik_metrics_priority }}
{% endif %}

traefik.http.routers.{{ flaresolverr_identifier }}-metrics.service={{ flaresolverr_identifier }}-metrics

{% if middlewares | length > 0 %}
traefik.http.routers.{{ flaresolverr_identifier }}-metrics.middlewares={{ middlewares | join(',') }}
{% endif %}

traefik.http.routers.{{ flaresolverr_identifier }}-metrics.entrypoints={{ flaresolverr_container_labels_traefik_metrics_entrypoints }}

traefik.http.routers.{{ flaresolverr_identifier }}-metrics.tls={{ flaresolverr_container_labels_traefik_metrics_tls | to_json }}
{% if flaresolverr_container_labels_traefik_metrics_tls %}
traefik.http.routers.{{ flaresolverr_identifier }}-metrics.tls.certResolver={{ flaresolverr_container_labels_traefik_metrics_tls_certResolver }}
{% endif %}

traefik.http.services.{{ flaresolverr_identifier }}-metrics.loadbalancer.server.port={{ flaresolverr_container_metrics_port }}

########################################################################
#                                                                      #
# /Metrics                                                             #
#                                                                      #
########################################################################
{% endif %}

{% endif %}

{{ flaresolverr_container_labels_additional_labels }}
